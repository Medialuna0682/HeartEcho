# 心语 · HeartEcho —— 不要提交的东西

# ---------------------------------------------------------------
# ① 运行时数据：真实聊天记录、记忆、账单、API Key、协议端令牌、日志、备份
#    这些只属于跑这份程序的那台机器。
#    仓库里也**不带任何角色卡**（角色卡是使用者的创作内容）——
#    想要现成模板就复制 examples/character.example.json 到 data/characters/。
# ---------------------------------------------------------------
data/

# ---------------------------------------------------------------
# ② 第三方协议端（SnowLuma / NapCat）：体积大、有自己的 EULA、而且含 QQ 登录态
#    心语不内嵌协议端，需要的人自己放进来（README「〇、从这个仓库拉下来之后」有说明）
# ---------------------------------------------------------------
protocol/

# ---------------------------------------------------------------
# ③ 打包产物与中间文件
# ---------------------------------------------------------------
build/
dist/
*.exe
sea-config.json
sea-prep.blob

# ---------------------------------------------------------------
# ④ 本机设置（里面有绝对路径）
# ---------------------------------------------------------------
心语设置.json
!心语设置.example.json

# ---------------------------------------------------------------
# ⑤ 个人文档（角色设定、聊天记录导出等）
#    里面有真实姓名、城市、作息这类私人信息，默认不进仓库。
#    想公开分享就把这一行删掉，或者自己另开一个专门的仓库。
# ---------------------------------------------------------------
docs/

# ---------------------------------------------------------------
# ⑥ 开发依赖与杂项
# ---------------------------------------------------------------
node_modules/
# 多实例的登记表和每个实例的目录（里面有自己的 config.json 和 API Key）
instances/
instances.json
*.log
*.tmp
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/


# 扩展注册表（由 tools/gen-extensions.mjs 在打包前生成）
lib/extensions.generated.mjs

# 用户下载的扩展包原始素材（移植到 extensions/ 后不再提交）
插件及SKILL/
